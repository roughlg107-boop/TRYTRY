# ===========================================
# 環境變數範例 — 請複製為 .env 並填入實際值
# 勿將 .env 或真實 key 提交至 repo
# ===========================================

# ---------- Backend（Render / 本機） ----------
# OpenAI API 金鑰，供 STEP 1 / 3 / 4 等呼叫 OpenAI 使用
OPENAI_API_KEY=

# Firebase Admin SDK（若需驗證 ID Token 或寫入 Firestore）
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 從 Service Account JSON 複製 private_key，保留 \n 換行或於程式內還原
FIREBASE_PRIVATE_KEY=

# 執行環境（Render 會注入 PORT）
NODE_ENV=production
# PORT=3000

# 若需 CORS，設定前端網址（如 Firebase Hosting URL）
# FRONTEND_ORIGIN=https://your-project.web.app

# ---------- Frontend（建置時） ----------
# 後端 API 基底 URL（本機開發可用 http://localhost:3000）
# VITE_API_BASE_URL=https://your-backend.onrender.com
